<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="Volume Control" Height="200" Width="400">
    <Grid>
        <Slider Name="VolumeSlider"  Minimum="0" Maximum="100" Value="50" 
            LargeChange="10" SmallChange="1" TickFrequency="1" VerticalAlignment="Center" Width="300" ValueChanged="VolumeSlider_ValueChanged" Margin="50,0,50,0" />
        <TextBlock Name="VolumeTextBlock" VerticalAlignment="Top" HorizontalAlignment="Center" 
               FontSize="24" Margin="0,10,0,0" />
    </Grid>
</Window>
